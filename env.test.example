# ─────────────────────────────────────────────────────────────────────────
# .env ДЛЯ ТЕСТОВОЙ СРЕДЫ (/home/inga-your-guide-test/.env)
#
# Скопировать этот файл в .env тестовой папки и заполнить.
# ⚠️ НЕ копировать боевой .env целиком: пароль базы и JWT_SECRET
#    должны быть СВОИ, иначе тест и прод перестанут быть изолированы.
# ─────────────────────────────────────────────────────────────────────────

# ── База данных (своя, отдельная от боевой) ────────────────────────────
POSTGRES_USER=inga_db_user
POSTGRES_PASSWORD=ПРИДУМАЙТЕ_ДРУГОЙ_ПАРОЛЬ
POSTGRES_DB=postgres
# Пароль здесь должен совпадать с POSTGRES_PASSWORD выше (между : и @)
DATABASE_URL=postgresql://inga_db_user:ПРИДУМАЙТЕ_ДРУГОЙ_ПАРОЛЬ@db:5432/postgres

# ── Секрет для токенов входа (свой; сгенерировать: openssl rand -hex 32) ──
JWT_SECRET=СГЕНЕРИРОВАТЬ_СВОЙ

# ── Адреса тестовой среды ──────────────────────────────────────────────
SITE_URL=https://test.legche.online
APP_URL=https://test.legche.online
VITE_API_URL=https://test.legche.online/api/v1
CORS_ORIGIN=https://test.legche.online

# ── ИИ (можно те же ключи, что на проде) ───────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Почта (те же ящики; цепочка писем на тесте всегда выключена) ────────
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SENDER_NAME=Инга
SMTP_INGA_USER=inga@legche.online
SMTP_INGA_PASS=
SMTP_SUPPORT_USER=support@legche.online
SMTP_SUPPORT_PASS=
