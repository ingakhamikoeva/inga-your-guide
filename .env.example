# ═══════════════════════════════════════════════════════════════
#  Self-hosted Legche / Инга — environment configuration
#
#  Quick start:
#    cp .env.example .env
#    # edit values below, then:
#    docker compose up -d
# ═══════════════════════════════════════════════════════════════

# ── Domain ─────────────────────────────────────────────────────
SITE_URL=https://legche.online
# Host port for the frontend SPA (nginx). 8080 by default — change to 80
# if free.
WEB_HTTP_PORT=8080

# ── Postgres (local container) ─────────────────────────────────
POSTGRES_USER=inga_db_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
DATABASE_URL=postgresql://inga_db_user:change-me@db:5432/postgres

# ── JWT ────────────────────────────────────────────────────────
# Random 32+ byte secret. Generate: openssl rand -base64 48
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=https://legche.online,https://www.legche.online

# ── DeepSeek (AI provider) ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── SMTP (password reset, email confirm) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Inga
SMTP_ADMIN_EMAIL=admin@legche.online

# ── OAuth (Phase 6 — wire up later) ────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# ── Frontend (build-time, baked into the JS bundle) ────────────
# Points the SPA at the self-hosted Node API. MUST include the /api/v1 prefix.
VITE_API_URL=https://api.legche.online/api/v1
