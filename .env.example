# ──────────────────────────────────────────────────────────────
# FRONTEND (build-time, baked into JS bundle — PUBLIC values only)
# ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...your-anon-key...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# URL of the self-hosted API container (the `api` service in docker-compose).
# Leave empty to keep using Lovable edge functions.
# Examples: http://localhost:8787  |  https://api.legche.online
VITE_API_BASE_URL=http://localhost:8787

# ──────────────────────────────────────────────────────────────
# BACKEND API (server-only, NEVER exposed to the browser)
# ──────────────────────────────────────────────────────────────

# Postgres connection (your own Supabase or any Postgres).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Used by the API to validate user JWTs.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# DeepSeek (LLM provider for ask-inga and estimate-nutrition).
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# CORS: domain that may call the API. Use comma-separated list or "*" for any.
CORS_ORIGIN=https://legche.online,https://www.legche.online
