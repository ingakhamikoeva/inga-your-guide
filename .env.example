# Build-time переменные для docker-compose / Vite.
# Вариант A — продолжаете использовать Lovable Cloud (быстрее всего):
#   возьмите значения из текущего .env проекта Lovable.
# Вариант B — подняли свой Supabase: подставьте URL и anon key своего проекта.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...your-anon-key...
VITE_SUPABASE_PROJECT_ID=your-project-ref
