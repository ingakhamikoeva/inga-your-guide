# ═══════════════════════════════════════════════════════════════
#  Self-hosted Supabase stack — environment configuration
#
#  Quick start:
#    cp .env.example .env
#    ./scripts/generate-keys.sh >> .env    # adds JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY
#    docker compose up -d
# ═══════════════════════════════════════════════════════════════

# ── Domain ─────────────────────────────────────────────────────
SITE_URL=https://legche.online
API_EXTERNAL_URL=https://api.legche.online
# Host port for the frontend SPA (nginx). Default 8080 to avoid conflict
# with a system nginx/apache already bound to :80. Set to 80 if free.
WEB_HTTP_PORT=8080


# ── Postgres (local container) ─────────────────────────────────
POSTGRES_USER=inga_db_user
POSTGRES_PASSWORD=67hhhVKHD4
POSTGRES_DB=postgres
DATABASE_URL=postgresql://inga_db_user:67hhhVKHD4@db:5432/postgres

# ── JWT (generate via ./scripts/generate-keys.sh) ──────────────
# JWT_SECRET=<48-byte base64url>
# ANON_KEY=<signed JWT, role=anon>
# SERVICE_ROLE_KEY=<signed JWT, role=service_role>

# ── GoTrue (auth) ──────────────────────────────────────────────
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=false

# SMTP for transactional emails (signup confirm, password reset).
# Leave empty during initial bring-up if you set GOTRUE_MAILER_AUTOCONFIRM=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Inga
SMTP_ADMIN_EMAIL=admin@legche.online

# Google OAuth (optional)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# Apple OAuth (optional)
GOTRUE_EXTERNAL_APPLE_ENABLED=false
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=
GOTRUE_EXTERNAL_APPLE_SECRET=

# ── Realtime ───────────────────────────────────────────────────
# 64-byte random secret (Phoenix). Generate: openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=

# ── DeepSeek (our Node API) ────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CORS_ORIGIN=https://legche.online,https://www.legche.online

# ── Frontend (build-time, baked into JS bundle) ────────────────
# Point the SPA at the self-hosted Node API. When VITE_API_URL is
# set the app uses the standalone auth + data endpoints; when it's
# empty the app falls back to Supabase (Lovable preview).
VITE_API_URL=https://api.legche.online/api/v1

# Legacy — kept for backwards compatibility with api-invoke.ts.
# If both are set, VITE_API_URL wins.
VITE_API_BASE_URL=https://api.legche.online/api/v1

# Only needed while still running the Lovable preview build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=self-hosted

