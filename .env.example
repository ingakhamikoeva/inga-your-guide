# ──────────────────────────────────────────────────────────────
# FRONTEND (build-time, baked into JS bundle — PUBLIC values only)
# ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...your-anon-key...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# URL of the self-hosted API container. Empty = use Lovable edge functions.
VITE_API_BASE_URL=http://localhost:8787

# ──────────────────────────────────────────────────────────────
# BACKEND API (server-only secrets, NEVER exposed to the browser)
# ──────────────────────────────────────────────────────────────

# Postgres connection (your own DB).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require

# JWT secret of the Supabase project that issues the tokens (HS256).
# Where to find it:
#   own Supabase  → Project Settings → API → JWT Settings → "JWT Secret"
#   self-hosted   → value of GOTRUE_JWT_SECRET in your Supabase .env
# The API uses it to verify tokens LOCALLY. No network calls to Supabase.
JWT_SECRET=your-supabase-jwt-secret

# DeepSeek (LLM provider for ask-inga and estimate-nutrition).
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# CORS: domain(s) allowed to call the API. Comma-separated or "*".
CORS_ORIGIN=https://legche.online,https://www.legche.online
