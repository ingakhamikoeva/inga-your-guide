# ═══════════════════════════════════════════════════════════════
#  Self-hosted Legche / Инга — environment configuration
#
#  Quick start:
#    cp .env.example .env
#    # edit values below, then:
#    docker compose up -d
# ═══════════════════════════════════════════════════════════════

# ── Domain ─────────────────────────────────────────────────────
SITE_URL=https://legche.online
# Адрес самого приложения (используется в кнопках писем).
APP_URL=https://app.legche.online
# Host port for the frontend SPA (nginx). 8080 by default — change to 80
# if free.
WEB_HTTP_PORT=8080

# ── Postgres (local container) ─────────────────────────────────
POSTGRES_USER=inga_db_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
DATABASE_URL=postgresql://inga_db_user:change-me@db:5432/postgres

# ── JWT ────────────────────────────────────────────────────────
# Random 32+ byte secret. Generate: openssl rand -base64 48
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=https://legche.online,https://www.legche.online

# ── DeepSeek (AI provider) ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── SMTP (Zoho, домен legche.online) ────────────────────────────
# Один сервер на весь домен, но у каждого ящика свой пароль приложения
# (Zoho Accounts → Security → App Passwords — НЕ обычный пароль от почты).
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SENDER_NAME=Инга

# support@legche.online — системные письма (сброс пароля)
SMTP_SUPPORT_USER=support@legche.online
SMTP_SUPPORT_PASS=

# inga@legche.online — живой голос (приветствие, письма дня 3/7)
SMTP_INGA_USER=inga@legche.online
SMTP_INGA_PASS=

# Цепочка триала (День 3/6/10, тексты утверждены 20.07.2026) выключена
# по умолчанию — включить true после проверки тестовой отправкой.
EMAIL_DRIP_ENABLED=false

# ── Юридические документы ──────────────────────────────────────
# Редакция оферты и политики ПД, опубликованных на legche.online.
# Пишется в consent_doc_version при регистрации, поэтому обязана
# совпадать с датой в шапке документов. Меняется вместе с текстами.
LEGAL_DOCS_VERSION=2026-09-01

# ── OAuth (Phase 6 — wire up later) ────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# ── Frontend (build-time, baked into the JS bundle) ────────────
# Points the SPA at the self-hosted Node API. MUST include the /api/v1 prefix.
VITE_API_URL=https://api.legche.online/api/v1
